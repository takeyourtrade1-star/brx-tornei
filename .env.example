# Origin REST server-only. Il browser usa esclusivamente i BFF same-origin.
AUTH_API_URL=

# Allowlist server-only: hostname DNS esatti (minuscoli, senza wildcard/porte),
# separati da virgola. Ogni origin HTTPS/WSS configurato sotto deve appartenervi.
TRUSTED_HTTPS_HOSTNAMES=auth.ebartex.com,sync.ebartex.com,api-tornei.ebartex.com,tornei.ebartex.com,www.ebartex.com
TRUSTED_UPSTREAM_HOSTS=auth.ebartex.com,sync.ebartex.com,api-tornei.ebartex.com

# URL pubblico di QUESTO sito (canonical, metadata, redirect assoluti)
NEXT_PUBLIC_SITE_URL=https://tornei.ebartex.com

# Sito principale (link registrazione, ritorno alla home Ebartex)
NEXT_PUBLIC_MAIN_SITE_URL=https://www.ebartex.com

# CDN asset condivisi (CloudFront). In dev usa il fallback hardcoded in lib/config.ts
NEXT_PUBLIC_CDN_URL=

# BRX Sync API — inventario utente, server-only
SYNC_API_URL=

# Tournament Service REST — server-only
TOURNAMENTS_API_URL=
# Origin WebSocket esplicito, stesso host dell'API e protocollo wss://.
NEXT_PUBLIC_TOURNAMENTS_WS_ORIGIN=

# Finché non esistono API di scrittura persistenti, questi flag devono restare
# false. Sono accettati esclusivamente con NODE_ENV=development.
ENABLE_EPHEMERAL_DECK_MUTATIONS=false
ENABLE_EPHEMERAL_INVENTORY_MUTATIONS=false

# Meilisearch — catalogo carte (stesse variabili di new_frontend_brx)
# Server-side: use a key restricted to search actions only.
MEILISEARCH_URL=
MEILISEARCH_SEARCH_KEY=
MEILISEARCH_INDEX=cards

# BRX Match — server-only; nessun fallback pubblico in produzione.
BRX_MATCH_API_URL=
BRX_MATCH_ALLOWED_ORIGIN=
BRX_MATCH_INTERNAL_TOKEN=
BRX_MATCH_INTERNAL_CALLER=brx-tornei
# Immutable SHA-256 from the independently approved ONNX release artifact.
BRX_MATCH_EDGE_MODEL_SHA256=

# WebRTC — only public STUN URLs belong in the browser build. TURN credentials
# are minted ephemerally by the authenticated Tournament Service.
NEXT_PUBLIC_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Signaling webcam condiviso tra istanze Lambda/Amplify (server-only).
# In produzione entrambi sono obbligatori; secret casuale di almeno 32 caratteri.
WEBCAM_RELAY_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_ALLOWED_HOSTNAME=
UPSTASH_REDIS_REST_TOKEN=
