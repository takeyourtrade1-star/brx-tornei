# Origin REST server-only. Il browser usa esclusivamente i BFF same-origin.
AUTH_API_URL=

# Allowlist server-only: hostname DNS esatti (minuscoli, senza wildcard/porte),
# separati da virgola. Ogni origin HTTPS/WSS configurato sotto deve appartenervi.
TRUSTED_HTTPS_HOSTNAMES=auth.ebartex.com,auction.ebartex.com,sync.ebartex.com,api-tornei.ebartex.com,tornei.ebartex.com,www.ebartex.com
TRUSTED_UPSTREAM_HOSTS=auth.ebartex.com,auction.ebartex.com,sync.ebartex.com,api-tornei.ebartex.com

# URL pubblico di QUESTO sito (canonical, metadata, redirect assoluti)
NEXT_PUBLIC_SITE_URL=https://tornei.ebartex.com

# Sito principale (link registrazione, ritorno alla home Ebartex)
NEXT_PUBLIC_MAIN_SITE_URL=https://www.ebartex.com

# Handoff Ebartex -> Tornei. Il secret e server-only e deve coincidere con
# SSO_TOURNAMENTS_CLIENT_SECRET dell'Auth (random URL-safe, 32-256 caratteri).
SSO_HANDOFF_ENABLED=false
SSO_TOURNAMENTS_CLIENT_SECRET=

# CDN asset condivisi (CloudFront). In dev usa il fallback hardcoded in lib/config.ts
NEXT_PUBLIC_CDN_URL=

# BRX Sync API — inventario utente, server-only
SYNC_API_URL=

# Tournament Service REST — server-only
TOURNAMENTS_API_URL=
# Segreto condiviso col Tournament Service (SSM: TOURNAMENT_FIRSTPARTY_TOKEN).
# Dichiara che questo frontend è il reverse proxy davanti a tutta l'utenza:
# senza di esso il backend conta ogni lettura RSC sulla quota per-indirizzo del
# nostro unico IP di uscita e il sito si autolimita con pochi utenti online.
# Server-only, mai NEXT_PUBLIC_. Minimo 32 caratteri ASCII in release.
TOURNAMENTS_SERVICE_TOKEN=
# Auction REST — server-only; il feed notifiche è condiviso con il marketplace
AUCTION_API_URL=
# Origin WebSocket esplicito, stesso host dell'API e protocollo wss://.
NEXT_PUBLIC_TOURNAMENTS_WS_ORIGIN=

# Password server-only della Sala Arcade (12-256 caratteri). Non usare NEXT_PUBLIC_*.
# La rotazione invalida automaticamente tutti gli accessi già concessi.
ARCADE_ROOM_ACCESS_PASSWORD=

# Attivare solo dopo deploy coordinato di API, bucket privato e lifecycle.
# Il browser conserva un pre-roll locale e carica esclusivamente i gap P2P.
NEXT_PUBLIC_MATCH_GAP_RECORDING_ENABLED=false
# Origin esatto del bucket (es. https://bucket.s3.eu-south-1.amazonaws.com).
# Va aggiunto anche a TRUSTED_HTTPS_HOSTNAMES e alla CSP tramite questa env.
# In sviluppo può essere il loopback del backend, es. http://localhost:8000.
NEXT_PUBLIC_MATCH_GAP_UPLOAD_ORIGIN=

# Finché non esistono API di scrittura persistenti, questi flag devono restare
# false. Sono accettati esclusivamente con NODE_ENV=development.
ENABLE_EPHEMERAL_DECK_MUTATIONS=false
ENABLE_EPHEMERAL_INVENTORY_MUTATIONS=false
ENABLE_EPHEMERAL_SOCIAL=false

# Meilisearch — catalogo carte (stesse variabili di new_frontend_brx)
# Server-side: use a key restricted to search actions only.
MEILISEARCH_URL=
MEILISEARCH_SEARCH_KEY=
# Alias compatibili lato server: MEILISEARCH_SEARCH_API_KEY, MEILISEARCH_API_KEY.
MEILISEARCH_INDEX=cards

# BRX Match — server-only; nessun fallback pubblico in produzione.
BRX_MATCH_API_URL=
BRX_MATCH_ALLOWED_ORIGIN=
BRX_MATCH_INTERNAL_TOKEN=
BRX_MATCH_INTERNAL_CALLER=brx-tornei
# Immutable SHA-256 from the independently approved ONNX release artifact.
BRX_MATCH_EDGE_MODEL_SHA256=

# WebRTC — only public STUN URLs belong in the browser build. TURN credentials
# are minted ephemerally by the authenticated Tournament Service.
NEXT_PUBLIC_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Signaling webcam condiviso tra istanze Lambda/Amplify (server-only).
# In produzione entrambi sono obbligatori; secret casuale di almeno 32 caratteri.
WEBCAM_RELAY_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_ALLOWED_HOSTNAME=
UPSTASH_REDIS_REST_TOKEN=
# Amplify/CloudFront: il valore affidabile è l'ultimo hop aggiunto a XFF.
# In alternativa usare un solo header infrastrutturale ammesso, per esempio:
# TRUSTED_CLIENT_IP_HEADER=cloudfront-viewer-address
TRUSTED_PROXY_HOPS=1
